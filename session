#!/bin/sh
# The LVGL screen program on the DRM display, run by /etc/init.d/e5-infoscreen (instance "ui").
TZ=$(cat /etc/TZ 2>/dev/null)
export TZ=${TZ:-UTC0}

# The api instance starts next to this one; wait up to ten seconds for it
# (8088 = 0x1F98, listening = state 0A).
i=0
while ! grep -q ':1F98 00000000:0000 0A' /proc/net/tcp && [ $i -lt 100 ]; do /opt/e5/bin/busybox sleep 0.1; i=$((i + 1)); done

exec /usr/libexec/e5-infoscreen/ui
